  "flow": {
    "actions": [
      {
        "id": "set-power",
        "title": {
          "en": "Set power",
          "nl": "Vermogen instellen",
          "de": "Vermogen einstellen",
          "fr": "Définir le pouvoir"
        },
        "titleFormatted": {
          "en": "Set power to [[power]] watts",
          "nl": "Vermogen instellen op [[power]] watt",
          "de": "Vermogen einstellen auf [[power]] watt",
          "fr": "Définir le pouvoir à [[power]] watts"
        },
        "hint": {
          "en": "Set the power of the battery. Positive values discharge the battery, negative values charge the battery.",
          "nl": "Stel het vermogen van de batterij in. Positieve waarden ontladen de batterij, negatieve waarden laden de batterij op.",
          "de": "Stellen Sie das Vermogen der Batterie ein. Positive Werte entladen die Batterie, negative Werte laden die Batterie auf.",
          "fr": "Définissez le pouvoir de la batterie. Les valeurs positives déchargent la batterie, les valeurs négatives la chargent."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zendure"
          },
          {
            "type": "number",
            "name": "power",
            "placeholder": {
              "en": "800",
              "nl": "800",
              "de": "800",
              "fr": "800"
            },
            "min": -2400,
            "max": 2400,
            "step": 1
          }
        ]
      },
      {
        "id": "reset-meters",
        "title": {
          "en": "Reset energy meters",
          "nl": "Meterstanden op 0 zetten",
          "de": "Energiezähler zurücksetzen",
          "fr": "Réinitialiser les compteurs d'énergie"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zendure"
          }
        ]
      },
      {
        "id": "set-output-limit",
        "title": {
          "en": "Set output limit (discharge cap)",
          "nl": "Ontlaadlimiet instellen",
          "de": "Ausgabelimit setzen (Entladegrenze)",
          "fr": "Définir la limite de sortie (capacité de décharge)"
        },
        "titleFormatted": {
          "en": "Cap discharge at [[limit]] W (0 = block discharge)",
          "nl": "Ontladen begrenzen op [[limit]] W (0 = blokkeer ontladen)",
          "de": "Entladegrenze setzen auf [[limit]] W (0 = Entladung blockieren)",
          "fr": "Limiter la décharge à [[limit]] W (0 = bloquer la décharge)"
        },
        "hint": {
          "en": "Atomic write of outputLimit only. Does not touch inputLimit, smartMode or acMode. Use 0 to block discharge while allowing solar/grid charging.",
          "nl": "Schrijft alleen outputLimit. Raakt inputLimit, smartMode en acMode niet aan. Gebruik 0 om ontladen te blokkeren terwijl zon/grid laden mag.",
          "de": "Nur atomares Schreiben von outputLimit. Berührt inputLimit, smartMode oder acMode nicht. Verwenden Sie 0, um die Entladung zu blockieren, während Solarenergie/Grid-Laden erlaubt ist.",
          "fr": "Écriture atomique de outputLimit uniquement. Ne touche pas inputLimit, smartMode ou acMode. Utilisez 0 pour bloquer la décharge tout en autorisant le chargement solaire/réseau."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zendure"
          },
          {
            "type": "number",
            "name": "limit",
            "placeholder": {
              "en": "0",
              "nl": "0",
              "de": "0",
              "fr": "0"
            },
            "min": 0,
            "max": 2400,
            "step": 1
          }
        ]
      },
      {
        "id": "set-min-soc",
        "title": {
          "en": "Set minimum SOC",
          "nl": "Minimum-SOC instellen",
          "de": "Minimalen SOC setzen",
          "fr": "Définir le SOC minimum"
        },
        "titleFormatted": {
          "en": "Set min SOC to [[percent]]% (Zenki refuses to discharge below)",
          "nl": "Minimum-SOC op [[percent]]% (Zenki ontlaadt niet dieper)",
          "de": "Minimalen SOC auf [[percent]]% setzen (Zenki verweigert Entladung unterhalb)",
          "fr": "Définir le SOC minimum à [[percent]]% (Zenki refuse de décharger en dessous)"
        },
        "hint": {
          "en": "Atomic write of minSoc only. Use as alternative discharge-blocker: set min-SOC to current SOC and Zenki refuses to discharge further. Reverts in HA take 'few minutes' (per Zendure-HA #838). Range clamped to 5-50% for battery health.",
          "nl": "Schrijft alleen minSoc. Alternatief voor blokkade: zet min-SOC op huidige SOC en Zenki ontlaadt niet verder. Revert in HA duurt 'enkele minuten' (per Zendure-HA #838). Range geklemd op 5-50% voor batterijgezondheid.",
          "de": "Nur atomares Schreiben von minSoc. Als alternatives Entladeblocker verwenden: Setzen Sie min-SOC auf aktuellen SOC und Zenki verweigert weitere Entladung. Zurücksetzen in HA dauert 'einige Minuten' (pro Zendure-HA #838). Bereich auf 5-50% für Batterieschutz geklemmt.",
          "fr": "Écriture atomique de minSoc uniquement. Utilisez comme bloqueur de décharge alternatif : définissez le min-SOC sur le SOC actuel et Zenki refuse de décharger davantage. Les retours en arrière dans HA prennent 'quelques minutes' (par Zendure-HA #838). Plage limitée à 5-50% pour la santé de la batterie."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zendure"
          },
          {
            "type": "number",
            "name": "percent",
            "placeholder": {
              "en": "20",
              "nl": "20",
              "de": "20",
              "fr": "20"
            },
            "min": 5,
            "max": 50,
            "step": 1
          }
        ]
      },
      {
        "id": "set-pass-mode",
        "title": {
          "en": "Set bypass mode",
          "nl": "Bypass-modus instellen",
          "de": "Bypass-Modus setzen",
          "fr": "Définir le mode bypass"
        },
        "titleFormatted": {
          "en": "Set bypass mode to [[mode]]",
          "nl": "Bypass-modus op [[mode]]",
          "de": "Bypass-Modus auf [[mode]] setzen",
          "fr": "Définir le mode bypass à [[mode]]"
        },
        "hint": {
          "en": "Atomic write of passMode. Auto = follow firmware logic, Off = bypass disabled, On = force grid-passthrough (e.g. during low SOC or storm).",
          "nl": "Schrijft alleen passMode. Auto = firmware bepaalt, Uit = bypass uit, Aan = grid-passthrough forceren (bv. bij lage SOC of onweer).",
          "de": "Nur atomares Schreiben von passMode. Auto = Firmware-Logik folgen, Aus = Bypass deaktiviert, Ein = Grid-Passthrough erzwingen (z.B. bei niedrigem SOC oder Sturm).",
          "fr": "Écriture atomique de passMode. Auto = suivre la logique du firmware, Off = bypass désactivé, On = forcer le passage en réseau (ex : pendant un faible SOC ou une tempête)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zendure"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "values": [
              {
                "id": "0",
                "label": {
                  "en": "Auto",
                  "nl": "Auto",
                  "de": "Auto",
                  "fr": "Auto"
                }
              },
              {
                "id": "1",
                "label": {
                  "en": "Off",
                  "nl": "Uit",
                  "de": "Aus",
                  "fr": "Off"
                }
              },
              {
                "id": "2",
                "label": {
                  "en": "On",
                  "nl": "Aan",
                  "de": "Ein",
                  "fr": "On"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "set-grid-reverse",
        "title": {
          "en": "Set grid export mode",
          "nl": "Netinjectie-modus instellen",
          "de": "Netzexport-Modus setzen",
          "fr": "Définir le mode d'export réseau"
        },
        "titleFormatted": {
          "en": "Set grid export to [[mode]]",
          "nl": "Netinjectie op [[mode]]",
          "de": "Netzexport auf [[mode]] setzen",
          "fr": "Définir l'export réseau à [[mode]]"
        },
        "hint": {
          "en": "Atomic write of gridReverse. Disabled = no export, Allow = export enabled, Forbidden = firmware blocks export. Useful for negative-price tariffs (Tibber) where you want to stop exporting temporarily.",
          "nl": "Schrijft alleen gridReverse. Uit = geen netinjectie, Toestaan = injectie aan, Verboden = firmware blokkeert injectie. Handig voor negatieve prijzen (Tibber) als je tijdelijk niet wil terugleveren.",
          "de": "Nur atomares Schreiben von gridReverse. Deaktiviert = kein Export, Erlaubt = Export aktiviert, Verboten = Firmware blockiert Export. Nützlich für negative Preistarife (Tibber), bei denen du temporär den Export stoppen möchtest.",
          "fr": "Écriture atomique de gridReverse. Désactivé = pas d'export, Autorisé = export activé, Interdit = firmware bloque l'export. Utile pour les tarifs à prix négatif (Tibber) où vous souhaitez arrêter temporairement l'export."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zendure"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "values": [
              {
                "id": "0",
                "label": {
                  "en": "Disabled",
                  "nl": "Uitgeschakeld",
                  "de": "Deaktiviert",
                  "fr": "Désactivé"
                }
              },
              {
                "id": "1",
                "label": {
                  "en": "Allow",
                  "nl": "Toestaan",
                  "de": "Erlaubt",
                  "fr": "Autorisé"
                }
              },
              {
                "id": "2",
                "label": {
                  "en": "Forbidden",
                  "nl": "Verboden",
                  "de": "Verboten",
                  "fr": "Interdit"
                }
              }
            ]
          }
        ]
      }
    ]
  },
